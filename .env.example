# FeaziestFlow Backend Environment Configuration
# Copy this file to .env and replace placeholders with your actual configuration.
# DO NOT commit .env or sensitive credentials to version control.

# Server Port (default: 8080)
PORT=8080

# Environment: development | production | test
ENVIRONMENT=development

# Database Configuration (Supports either DATABASE_URL or individual variables below)
# Option A: Full Connection String URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kfdesktop?sslmode=disable

# Option B: Individual Connection Parameters (used if DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kfdesktop
DB_SSLMODE=disable

# Redis Configuration (Supports either REDIS_URL or individual variables below)
# Option A: Full Connection URL
REDIS_URL=redis://localhost:6379/0

# Option B: Individual Parameters (used if REDIS_URL is not provided)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Service Account Credentials JSON string (or paste full JSON string in single line)
# Example: {"type": "service_account", "project_id": "your-project", ...}
FIREBASE_CREDENTIALS_JSON=
